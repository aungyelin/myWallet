    "- %@" : {

    },
    "%@ %@" : {
      "comment" : "A label that describes the amount of money in the currency.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "Accessibility label and hint for the theme settings button in the profile view. The argument is the string “profile_theme_setting”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %@, %@" : {
      "comment" : "Constructs a string that concatenates the title, amount, and status of the transaction. The argument is the string “- %arg”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, %3$@"
          }
        }
      }
    },
    "%@, %@%@" : {
